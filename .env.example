# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env holds your tokens — it is git-ignored; never commit it.

# --- library (required) -------------------------------------------------
# Folder holding your music library on the host. Downloads are imported here
# as Artist/Album/NN - Title.ext. Mounted into the app container at /library.
MUSIC_LIBRARY_PATH=/path/to/your/music

# --- Plex (optional) ----------------------------------------------------
# With a token, each imported album triggers a partial library scan and the
# track is verified in Plex. Without one those steps just fail (logged) and
# everything else works.
# Token: PlexOnlineToken in Plex's Preferences.xml.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
PLEX_SECTION_ID=5
# The library folder as the *Plex* container sees it, for partial scans.
PLEX_LIBRARY_ROOT=/data/Music

# --- Spotify (optional) -------------------------------------------------
# Needed only for Spotify links (an app at developer.spotify.com). The
# redirect URI is only for connecting your account to list your playlists:
# http://<your-host>:3000/api/v1/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- download pacing ----------------------------------------------------
# Caps on downloads (0 = unlimited). Lower is gentler on YouTube.
TRACKS_PER_HOUR=60
TRACKS_PER_DAY=300

# --- staging guardrails -------------------------------------------------
STAGING_MAX_GB=30
STAGING_MIN_FREE_GB=5

LOG_LEVEL=INFO

# --- artist browsing ----------------------------------------------------
# YouTube Music metadata, not downloads: its own hourly budget, but it shares
# the governor's backoff. Background tracklist loading is spaced 2-4s apart.
CATALOG_REQUESTS_PER_HOUR=600
CATALOG_PREFETCH_DELAY_MIN=2
CATALOG_PREFETCH_DELAY_MAX=4

# --- discover -----------------------------------------------------------
# Background scan of the library's artists for new releases: one YouTube
# Music request per interval (12s ~ 300/hour, half the browsing budget).
DISCOVER_ENABLED=true
DISCOVER_REQUEST_INTERVAL=12
# Recommended artists also watched for new releases.
DISCOVER_SUGGESTED_ARTISTS=40
# Starting chart country: AU, US, GB... or ZZ for global.
DISCOVER_COUNTRY=ZZ

# --- library management -------------------------------------------------
# Tag-reading worker processes. Over a network mount the NAS is the limit,
# so more than ~32 buys latency, not speed.
LIBRARY_SCAN_WORKERS=32
# Advisory only - the trash is never purged automatically.
TRASH_RETENTION_DAYS=30

# --- metadata manager ---------------------------------------------------
# Keeps file tags, the folder layout and Plex in step with MusicBrainz:
# identifies every album, writes clean tags (MusicBrainz ids, genres, the
# primary artist as album artist), moves files to
# Artist/(Year) Album/NN - Title, and fixes Plex matches, genres, moods and
# cover art. Nothing is changed until you turn on auto-apply in the Library
# tab (or apply fixes by hand); every change can be undone there.
METADATA_ENABLED=true
METADATA_INTERVAL_MIN=30
# Hard limits on what may be changed, whatever auto-apply says.
METADATA_WRITE_FILES=true
METADATA_MOVE_FILES=true
METADATA_WRITE_PLEX=true
# Match score needed to act automatically / to offer a match for review.
METADATA_AUTO_CONFIDENCE=0.85
METADATA_REVIEW_CONFIDENCE=0.55
METADATA_MAX_GENRES=5
# MusicBrainz requires a way to contact you in the User-Agent (an email
# address or a URL). Lookups stay off until this is set.
MUSICBRAINZ_CONTACT=
# Free key from https://www.last.fm/api/account/create — genres and moods
# for releases MusicBrainz has no genres for (most small artists).
LASTFM_API_KEY=
