# Copy to .env and fill in. chmod 600 .env
# Plex
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
PLEX_SECTION_ID=5
PLEX_LIBRARY_ROOT=/data/Music

# Spotify API app (developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Rate governor (defaults shown)
TRACKS_PER_HOUR=60
TRACKS_PER_DAY=300

# Staging guardrails
STAGING_MAX_GB=30
STAGING_MIN_FREE_GB=5

LOG_LEVEL=INFO
